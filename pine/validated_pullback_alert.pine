//@version=5
// TREND PULLBACK — mirrors E:\PortfolioTracker\SwingTrading\find_setups.py exactly.
// Validated: PF 1.34 overall / 13.7% gated CAGR vs Nifty 11.0% (2006-2026).
// Apply to DAILY chart of each watchlist symbol. Alert: "Once Per Bar Close".
// NOTE: liquidity/mcap filters not possible in Pine - apply only to your
// top-150 universe list. Regime gate (Nifty>200DMA) must be checked manually
// or via INDIA index chart - no new longs when Nifty < its 200-DMA.

ind_len = input.int(20, "SMA length", minval=1)

sma20  = ta.sma(close, ind_len)
sma50  = ta.sma(close, 50)
sma200 = ta.sma(close, 200)

uptrend = close > sma200 and sma200 > sma200[20] and close > sma50
dipped  = ta.lowest(low, 5) <= sma20
reclaim = close > high[1] and close > sma20

pullbackSignal = uptrend and dipped and reclaim and not na(sma200)

plot(sma20,  "SMA20",  color.orange)
plot(sma50,  "SMA50",  color.teal)
plot(sma200, "SMA200", color.red)

plotshape(pullbackSignal, title="Pullback Signal", style=shape.triangleup,
          location=location.belowbar, color=color.green, size=size.small,
          text="PB")

alertcondition(pullbackSignal, title="Trend Pullback LONG",
               message='{{ticker}} PULLBACK setup @ {{close}} - enter next session near close, stop below 5-day low (find_setups.csv for qty)')
